# Build output.
/target

# Cargo registry and git caches, kept out of the tree.
/.cargo/registry
/.cargo/git

# redb store files. `database_path` names one, and the default
# `storage.redb` lives in the working directory. A test that opens the store
# outside a temporary directory leaves one here, and `git add -A` will
# otherwise commit it.
*.redb
